{
  "model": "kilo/nvidia/nemotron-3-ultra-550b-a55b:free",
  "default_agent": "code",
  "small_model": "kilo/nvidia/nemotron-3-ultra-550b-a55b:free",
  "permission": {
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "background_process": "allow",
    "agent_manager": "allow",
    "browser": "allow",
    "mcp": "allow",
    "skill": "allow",
    "external_directory": "deny",
    "todowrite": "allow",
    "question": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 30000
    },
    "github": {
      "type": "local",
      "command": ["npx", "@github/mcp@latest"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "provider": {
    "kilo-gateway": {
      "enabled": true,
      "options": {
        "timeout": 300000
      }
    }
  },
  "disabled_providers": [],
  "share": "manual",
  "autoupdate": "notify",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "instructions": ["AGENTS.md", "CLAUDE.md", "CONTEXT.md"],
  "snapshot": true,
  "skills": {
    "paths": [".kilo/worktrees/ritzy-colt/.github/skills", ".kilo/worktrees/truthful-swordfish/.github/skills"]
  }
}